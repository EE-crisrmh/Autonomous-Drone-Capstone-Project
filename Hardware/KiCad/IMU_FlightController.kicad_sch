		(uuid "f8068c85-8b35-4f9b-8788-c21cedc638d7")
	)
	(text_box "Note: MS5611 shares SPI bus with IMUs (IMU_MOSI, IMU_MISO, IMU_SCLK) for simplicity in v1.0. Each device has its own dedicated chip select (BARO_CS) to prevent bus conflicts. For v1.1 I'll move barometer to a dedicated SPI bus (BARO_MOSI, BARO_MISO, BARO_SCLK) to isolate pressure readings from IMU switching noise"
		(exclude_from_sim no)
		(at 40.005 168.91 0)
		(size 42.545 20.32)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "42a2348e-6756-49f2-b4f5-957f3f73fcab")
	)
	(text_box "Target heat power = 0.5 - 1W \nP = V^2 / R \n1 = 10.89 / R\nR ~ 10.8 ohms (split into 6, 1.8 ohms)\nsligthtly more power dissipation (1.089W)"
		(exclude_from_sim no)
		(at 109.855 153.67 0)
		(size 19.05 8.89)
		(margins 0.9525 0.9525 0.9525 0.9525)
