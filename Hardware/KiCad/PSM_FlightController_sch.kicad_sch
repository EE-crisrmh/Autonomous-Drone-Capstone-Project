	)
	(text_box "LDO 1: \nPowers the STM32F405, STM32F103, memory chips, connectors,\nbasically all the digital logic on the board.\n\nLDO 2: \nPowers only the IMUs, barometer, and magnetometer \ncompletely isolated from the logic rail.\n\nNotes: \nThe output cap is what maintains stability of the regulated output voltage and filters noise on the 3.3V rail. \nLDOs are actually more sensitive to output capacitance than input capacitance - a larger output cap gives better transient response when the load suddenly changes, like when the STM32 wakes up a peripheral. \nThe AMS1117 specifically requires a minimum output capacitance to stay stable. The input cap just needs to be large enough to prevent the input voltage from drooping when the LDO draws current - 10uF is enough for that job. \n(These values were recommended by the datasheet)"
		(exclude_from_sim no)
		(at 15.24 58.42 0)
		(size 153.67 33.02)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "a6d9bbf6-e1d3-4a49-a800-65cee474d567")
	)
